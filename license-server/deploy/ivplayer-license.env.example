LICENSE_PORT=8787
LICENSE_BIND=127.0.0.1
LICENSE_ADMIN_KEY=change-me-to-a-long-random-secret

PUBLIC_SITE_URL=https://ivplayer.tr
LICENSE_PUBLIC_URL=https://license.ivplayer.tr

# Prices in kuruş (299.00 TL = 29900). Client cannot override.
IVPLAYER_CURRENCY=TRY
IVPLAYER_ONE_YEAR_PRICE=29900
IVPLAYER_LIFETIME_PRICE=79900

PAYMENT_PROVIDER=paytr
# Fill after PayTR merchant approval. Never put these in frontend or git.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
# PayTR iFrame requires a phone field; digital product placeholder:
PAYTR_PLACEHOLDER_PHONE=5000000000

