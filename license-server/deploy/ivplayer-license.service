[Unit]
Description=IvPlayer license API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ivplayer/license-server
EnvironmentFile=-/etc/ivplayer-license.env
Environment=LICENSE_PORT=8787
Environment=LICENSE_BIND=127.0.0.1
ExecStart=/usr/bin/node index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
