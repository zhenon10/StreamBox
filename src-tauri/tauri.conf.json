{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IvPlayer",
  "version": "1.0.0",
  "identifier": "tr.ivplayer.desktop",
  "build": {
    "frontendDist": "../dist-windows",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode windows --port 5173 --strictPort",
    "beforeBuildCommand": "npx vite build --mode windows"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IvPlayer",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
